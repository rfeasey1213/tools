{
  "name": "LLM Tools Classroom Demo",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "python -m pip install --upgrade -r requirements.txt",
  "postStartCommand": "python app.py > /tmp/llm-tools-demo.log 2>&1 &",
  "forwardPorts": [7860],
  "portsAttributes": {
    "7860": {
      "label": "Company chatbot",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  }
}
